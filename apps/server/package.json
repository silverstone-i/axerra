 {
  "name": "@axerra/server",
  "version": "0.1.0",
  "description": "Axerra backend — project costing, profitability, and payments with double-entry accounting.",
  "license": "MIT",
  "author": "Ian Silverstone",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "setupAdmin:dev": "cross-env NODE_ENV=development node ./scripts/setupAdmin.js",
    "setupAdmin:test": "cross-env NODE_ENV=test node ./scripts/setupAdmin.js",
    "migrate:dev": "cross-env NODE_ENV=development node ./scripts/runMigrate.js",
    "migrate:test": "cross-env NODE_ENV=test node ./scripts/runMigrate.js",
    "seed": "cross-env NODE_ENV=development node ./scripts/seed.js",
    "seed:rbac": "cross-env NODE_ENV=development node ./scripts/seedRbac.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:unit": "cross-env NODE_ENV=test vitest run tests/unit",
    "test:integration": "cross-env NODE_ENV=test vitest run tests/integration",
    "test:contract": "cross-env NODE_ENV=test vitest run tests/contract",
    "test:rbac": "cross-env NODE_ENV=test vitest run tests/rbac",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage --reporter html",
    "dev": "cross-env NODE_ENV=development nodemon --delay 5 server.js",
    "start": "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg-schemata": "^1.3.2",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
