{
  "name": "axerra",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:serv": "npm -w apps/server run dev",
    "dev:client": "npm -w apps/client run dev",
    "dev": "npm run dev:serv & npm run dev:client",
    "build": "npm -w apps/server run build && npm -w apps/client run build",
    "lint": "eslint .",
    "test": "npm -w apps/server test",
    "arch": "node scripts/arch/runAll.js",
    "arch:check": "node scripts/arch/runAll.js --check",
    "arch:ai": "node scripts/arch/aiInterpret.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/server/**/*.js": [
      "eslint --fix"
    ],
    "apps/client/**/*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3"
  }
}
